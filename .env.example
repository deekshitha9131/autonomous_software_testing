PROJECT_NAME=Agentic GenAI Framework
VERSION=0.1.0
API_V1_STR=/api/v1
DEBUG=False

# LLM Provider Configuration
# Set LLM_PROVIDER to one of: "groq", "openai", "gemini"
LLM_PROVIDER=gemini

# Gemini Configuration (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# Groq Configuration (used when LLM_PROVIDER=groq or auto-selected)
GROQ_API_KEY=
GROQ_MODEL=

# OpenAI Configuration (used when LLM_PROVIDER=openai or auto-selected)
OPENAI_API_KEY=
OPENAI_MODEL=